{
  "name": "sweetcraft-launcher",
  "version": "0.6.0-rc.18",
  "private": true,
  "description": "SweetCraft Launcher — client verifier/consumer of the SweetCraft distribution protocol",
  "author": {
    "name": "SweetCraft / XBASE"
  },
  "type": "module",
  "main": "dist-desktop/main/main.js",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "install:all": "pnpm install --frozen-lockfile && pnpm --dir ui install --frozen-lockfile",
    "version:generate": "tsx scripts/version-generate.mts",
    "version:check": "tsx scripts/version-check.mts",
    "build": "pnpm version:generate && pnpm version:check && tsc -p tsconfig.json",
    "test": "tsx --test tests/**/*.test.ts tests/**/**/*.test.ts && pnpm desktop:ui:test",
    "desktop:shared:build": "tsc -p desktop/tsconfig.json && node scripts/copy-preload.mjs",
    "desktop:ui:build": "pnpm --dir ui run build",
    "desktop:ui:test": "pnpm --dir ui run test",
    "desktop:build": "pnpm desktop:ui:build && pnpm desktop:shared:build",
    "desktop:package:prepare": "pnpm version:generate && pnpm version:check && pnpm build && pnpm desktop:build",
    "desktop:package:builder": "electron-builder --config electron-builder.yml --win --x64 --publish never",
    "desktop:package": "pnpm desktop:package:prepare && pnpm desktop:package:builder",
    "desktop:package:renderer-smoke": "tsx scripts/pack07-renderer-smoke.mts",
    "release:manifest": "tsx scripts/release/generate-manifest.mts",
    "release:body": "tsx scripts/release/render-release-body.mts",
    "desktop:icon:generate": "tsx scripts/generate-windows-icon.mts",
    "desktop:test": "tsx --test tests/desktop/**/*.test.ts",
    "desktop:dev:ui": "pnpm --dir ui exec ng serve --host 127.0.0.1 --port 4201",
    "desktop:dev:electron": "pnpm desktop:shared:build && cross-env DESKTOP_DEV_SERVER=http://127.0.0.1:4201/ electron .",
    "desktop:dev": "pnpm desktop:shared:build && concurrently -k -n ui,electron -c magenta,cyan \"pnpm desktop:dev:ui\" \"wait-on http://127.0.0.1:4201 && cross-env DESKTOP_DEV_SERVER=http://127.0.0.1:4201/ electron .\"",
    "desktop:fake-auth:reset": "tsx scripts/reset-fake-auth.mts",
    "desktop:fake-install:reset": "tsx scripts/reset-fake-install.mts",
    "desktop:fake-play:reset": "tsx scripts/reset-fake-play.mts",
    "desktop:fake-reset": "tsx scripts/reset-fake-all.mts",
    "launcher:version": "tsx src/cli/main.ts version",
    "launcher:status": "tsx src/cli/main.ts status",
    "launcher:install": "tsx src/cli/main.ts install",
    "launcher:update": "tsx src/cli/main.ts update",
    "launcher:repair": "tsx src/cli/main.ts repair",
    "launcher:play": "tsx src/cli/main.ts play",
    "launcher:resolve": "tsx src/cli/main.ts resolve",
    "launcher:instance-plan": "tsx src/cli/main.ts instance-plan",
    "launcher:instance-audit": "tsx src/cli/main.ts instance-audit",
    "launcher:instance-repair": "tsx src/cli/main.ts instance-repair",
    "launcher:runtime-plan": "tsx src/cli/main.ts runtime-plan",
    "launcher:runtime-audit": "tsx src/cli/main.ts runtime-audit",
    "launcher:runtime-repair": "tsx src/cli/main.ts runtime-repair",
    "launcher:java-discover": "tsx src/cli/main.ts java-discover",
    "launcher:launch-plan": "tsx src/cli/main.ts launch-plan",
    "launcher:auth-info": "tsx src/cli/main.ts auth-info",
    "launcher:auth-url": "tsx src/cli/main.ts auth-url",
    "launcher:auth-login": "tsx src/cli/main.ts auth-login",
    "launcher:auth-status": "tsx src/cli/main.ts auth-status",
    "launcher:auth-logout": "tsx src/cli/main.ts auth-logout"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.3.0",
    "@types/semver": "^7.8.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.1.2",
    "electron-builder": "^26.15.3",
    "semver": "^7.8.5",
    "to-ico": "^1.1.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "wait-on": "^8.0.3"
  },
  "shortVersion": "0.6.0.18",
  "shortVersionWindows": "0.6.0.18"
}
