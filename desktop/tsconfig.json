{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../dist-desktop",
    "rootDir": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "declaration": false,
    "declarationMap": false,
    "skipLibCheck": true
  },
  "include": ["main/**/*.ts", "shared/**/*.ts"],
  "exclude": ["**/node_modules"]
}
